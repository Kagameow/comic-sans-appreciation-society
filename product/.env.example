# @nuxtjs/supabase reads these directly. Copy to .env and fill in.
# (Nuxt 4's CLI only auto-loads `.env`, not `.env.local`.)
# The NUXT_PUBLIC_ prefix is the canonical naming convention (it makes the
# value overridable at runtime via runtimeConfig). The unprefixed
# SUPABASE_URL / SUPABASE_KEY names are still accepted as fallbacks.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Server-only secret key (replaces the deprecated SERVICE_KEY). Required by
# `pnpm setup:visma-connect` to register the custom OIDC provider via the
# Supabase Auth admin API. Generate in Supabase Studio → Project Settings →
# API → secret key. Never expose to the browser.
NUXT_SUPABASE_SECRET_KEY=your-secret-key

# Visma Connect OIDC credentials. Register the app in the Visma Developer
# Portal first and whitelist this redirect URI in its "Redirect URIs":
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# Grant type must include `authorization_code`. Scopes: openid email profile.
NUXT_VISMA_CONNECT_CLIENT_ID=your-visma-client-id
NUXT_VISMA_CONNECT_CLIENT_SECRET=your-visma-client-secret

# Comma-separated list of emails that are allowed into /admin.
# The list is surfaced as `runtimeConfig.public.adminEmails` so the client
# admin route middleware can gate before any API call.
ADMIN_EMAILS=you@example.com

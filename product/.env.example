# Copy to .env and fill in. Both are needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Server-only — used by /api/admin/* routes to bypass RLS for admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of Google emails who are allowed into /admin.
ADMIN_EMAILS=tom.van.veen@visma.com

# POC: simulated "logged in" player name (drives the user header + super-code claim).
# Wire real auth later via @nuxtjs/supabase; this is just for the proof-of-concept.
NUXT_PUBLIC_CURRENT_PLAYER_NAME=Daan Nagtegaal
